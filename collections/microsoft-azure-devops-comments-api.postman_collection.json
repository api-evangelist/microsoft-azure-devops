          "name": "Azure DevOps Get work item comments",
          "request": {
            "name": "Azure DevOps Get work item comments",
            "description": {
              "content": "Returns all comments for a specific work item, ordered by creation date. Comments are user-authored notes attached to a work item and are separate from the work item's history.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wit",
                "workitems",
                ":id",
                "comments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "7.1",
                  "description": "(Required) Azure DevOps REST API version. Use 7.1 for the latest stable version."
                },
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "<integer>",
                  "description": "Maximum number of comments to return"
                },
                {
                  "disabled": false,
                  "key": "continuationToken",
                  "value": "<string>",
                  "description": "Continuation token for paging"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "id",
                  "description": "(Required) Numeric ID of the work item"
                },
                {
                  "description": "Azure DevOps organization name or ID",
                  "type": "any",
                  "value": "{{organization}}",
                  "key": "organization"
                },
                {
                  "description": "Azure DevOps project name or ID",
                  "type": "any",
                  "value": "{{project}}",
                  "key": "project"
                }
              ]
            },
            "header": [
