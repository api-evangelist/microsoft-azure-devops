          "name": "Azure DevOps List build artifacts",
          "request": {
            "name": "Azure DevOps List build artifacts",
            "description": {
              "content": "Returns a list of artifacts published by a specific build. Artifacts can be downloaded individually and include their name, type, and download URL.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "build",
                "builds",
                ":buildId",
                "artifacts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "7.1",
                  "description": "(Required) Azure DevOps REST API version. Use 7.1 for the latest stable version."
                },
                {
                  "disabled": false,
                  "key": "artifactName",
                  "value": "<string>",
                  "description": "Filter by a specific artifact name"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "buildId",
                  "description": "(Required) Numeric ID of the build"
                },
                {
                  "description": "Azure DevOps organization name or ID",
                  "type": "any",
                  "value": "{{organization}}",
                  "key": "organization"
                },
                {
                  "description": "Azure DevOps project name or ID",
                  "type": "any",
                  "value": "{{project}}",
                  "key": "project"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
