      "name": "Package Versions",
      "description": {
        "content": "Operations for managing specific package versions",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "df2a348e-059d-42eb-b627-0169dc9d1993",
          "name": "Azure DevOps Delete a package version",
          "request": {
            "name": "Azure DevOps Delete a package version",
            "description": {
              "content": "Deletes a specific version of a package from the feed. By default this moves the version to the recycle bin. Use the permanentlyDelete parameter to permanently remove it. Once permanently deleted, the version cannot be recovered and the same version number cannot be reused.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "packaging",
                "feeds",
                ":feedId",
                "packages",
                ":packageId",
                "versions",
                ":packageVersionId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "7.1",
                  "description": "(Required) Azure DevOps REST API version. Use 7.1 for the latest stable version."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "feedId",
                  "description": "(Required) Feed GUID or feed name"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "packageId",
                  "description": "(Required) GUID identifier of the package"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "packageVersionId",
                  "description": "(Required) GUID identifier of the package version"
                },
                {
                  "description": "Azure DevOps organization name or ID",
                  "type": "any",
                  "value": "{{organization}}",
                  "key": "organization"
                },
                {
                  "description": "Azure DevOps project name or ID",
                  "type": "any",
                  "value": "{{project}}",
                  "key": "project"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
          },
