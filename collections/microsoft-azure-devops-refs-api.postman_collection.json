    {
      "id": "a701bad6-6ec7-4b24-b7c7-45d593eb8856",
      "name": "Refs",
      "description": {
        "content": "Operations for managing branches and tags (refs)",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "87edae42-c19a-4a39-a973-27112be1936f",
          "name": "Azure DevOps List branches and refs",
          "request": {
            "name": "Azure DevOps List branches and refs",
            "description": {
              "content": "Returns a list of refs (branches and tags) for a repository. Supports filtering by a prefix string (e.g., \"heads/\" for branches, \"tags/\" for tags).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "git",
                "repositories",
                ":repositoryId",
                "refs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "7.1",
                  "description": "(Required) Azure DevOps REST API version. Use 7.1 for the latest stable version."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Prefix filter for ref names (e.g., 'heads/' returns branches)"
                },
                {
                  "disabled": false,
                  "key": "includeLinks",
                  "value": "<boolean>",
                  "description": "Whether to include _links"
                },
                {
                  "disabled": false,
                  "key": "includeStatuses",
                  "value": "<boolean>",
                  "description": "Whether to include commit status information"
                },
                {
                  "disabled": false,
                  "key": "includeMyBranches",
                  "value": "<boolean>",
                  "description": "Whether to prioritize branches created by the current user"
                },
                {
                  "disabled": false,
                  "key": "latestStatusesOnly",
                  "value": "<boolean>",
                  "description": "Return only the latest status for each ref"
                },
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "<integer>",
                  "description": "Maximum number of refs to return"
                },
                {
                  "disabled": false,
                  "key": "continuationToken",
                  "value": "<string>",
                  "description": "Continuation token for paging"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repositoryId",
                  "description": "(Required) GUID or name of the repository"
                },
                {
                  "description": "Azure DevOps organization name or ID",
                  "type": "any",
                  "value": "{{organization}}",
                  "key": "organization"
                },
                {
                  "description": "Azure DevOps project name or ID",
                  "type": "any",
                  "value": "{{project}}",
                  "key": "project"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
