          "request": {
            "name": "Azure DevOps Execute a WIQL query",
            "description": {
              "content": "Executes a Work Item Query Language (WIQL) query and returns a list of work item references that match the query criteria. WIQL is a SQL-like language specific to Azure DevOps work item querying.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wit",
                "wiql"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "7.1",
                  "description": "(Required) Azure DevOps REST API version. Use 7.1 for the latest stable version."
                },
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "<integer>",
                  "description": "Maximum number of results to return"
