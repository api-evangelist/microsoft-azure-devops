  "item": [
    {
      "id": "d712a514-b3f9-4c3a-9bb6-266b4d446c0d",
      "name": "Commits",
      "description": {
        "content": "Operations for accessing commits and commit history",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "556c2ca3-e315-4b87-82bc-ce9c717f2241",
          "name": "Azure DevOps List commits",
          "request": {
            "name": "Azure DevOps List commits",
            "description": {
              "content": "Returns a list of commits in a repository. Supports filtering by branch, author, date range, file path, and commit message text. Results are sorted by commit date (newest first by default).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "git",
                "repositories",
                ":repositoryId",
                "commits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "7.1",
                  "description": "(Required) Azure DevOps REST API version. Use 7.1 for the latest stable version."
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.itemVersion.version",
                  "value": "<string>",
                  "description": "Branch, tag, or commit SHA to start listing from"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.author",
                  "value": "<string>",
                  "description": "Filter by commit author name or email"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.fromDate",
                  "value": "<dateTime>",
                  "description": "Return commits after this date"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.toDate",
                  "value": "<dateTime>",
                  "description": "Return commits before this date"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.itemPath",
                  "value": "<string>",
                  "description": "Filter commits that touched this file or folder path"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.$top",
                  "value": "<integer>",
                  "description": "Maximum number of commits to return"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.$skip",
                  "value": "<integer>",
                  "description": "Number of commits to skip (for pagination)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repositoryId",
                  "description": "(Required) GUID or name of the repository"
                },
                {
                  "description": "Azure DevOps organization name or ID",
                  "type": "any",
                  "value": "{{organization}}",
                  "key": "organization"
                },
                {
                  "description": "Azure DevOps project name or ID",
                  "type": "any",
                  "value": "{{project}}",
                  "key": "project"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
