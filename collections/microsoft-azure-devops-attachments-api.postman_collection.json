          "name": "Azure DevOps Get attachment info",
          "request": {
            "name": "Azure DevOps Get attachment info",
            "description": {
              "content": "Returns metadata about an attachment by its GUID identifier. The response includes the attachment URL, file name, size, and creation date. Use the URL in the response to download the actual attachment content.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wit",
                "attachments",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "7.1",
                  "description": "(Required) Azure DevOps REST API version. Use 7.1 for the latest stable version."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) GUID of the attachment"
                },
                {
                  "description": "Azure DevOps organization name or ID",
                  "type": "any",
