          "name": "Azure DevOps List run artifacts",
          "request": {
            "name": "Azure DevOps List run artifacts",
            "description": {
              "content": "Returns a list of artifacts published by a specific pipeline run. Artifacts can include compiled binaries, test results, container images, or any other files published using the PublishBuildArtifacts or PublishPipelineArtifact task.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pipelines",
                ":pipelineId",
                "runs",
                ":runId",
                "artifacts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "7.1",
                  "description": "(Required) Azure DevOps REST API version. Use 7.1 for the latest stable version."
                },
                {
                  "disabled": false,
                  "key": "artifactName",
                  "value": "<string>",
                  "description": "Filter by a specific artifact name"
                },
                {
                  "disabled": false,
                  "key": "$expand",
                  "value": "<string>",
                  "description": "Expand additional artifact details"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "pipelineId",
                  "description": "(Required) Numeric ID of the pipeline"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "runId",
                  "description": "(Required) Numeric ID of the pipeline run"
                },
                {
                  "description": "Azure DevOps organization name or ID",
                  "type": "any",
                  "value": "{{organization}}",
                  "key": "organization"
                },
                {
                  "description": "Azure DevOps project name or ID",
                  "type": "any",
                  "value": "{{project}}",
                  "key": "project"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
